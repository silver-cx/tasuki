{
  "name": "tasuki",
  "version": "0.1.0",
  "description": "陪跑者把目标一棒一棒跑完的开源训练教练",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#schema": "./packages/schema/src/types.ts",
    "#adapters/metricbridge": "./packages/adapters/apple-metricbridge/src/index.ts",
    "#engine/*": "./packages/engine/src/*",
    "#knowledge": "./packages/knowledge/src/index.ts",
    "#adapters/apple-export": "./packages/adapters/apple-export/src/index.ts",
    "#store": "./packages/store/src/index.ts"
  },
  "scripts": {
    "report": "node --disable-warning=ExperimentalWarning apps/cli/src/main.ts report",
    "sync": "node --disable-warning=ExperimentalWarning apps/cli/src/main.ts sync",
    "import": "node --disable-warning=ExperimentalWarning apps/cli/src/main.ts import",
    "goal": "node --disable-warning=ExperimentalWarning apps/cli/src/main.ts goal",
    "plan": "node --disable-warning=ExperimentalWarning apps/cli/src/main.ts plan",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\""
  }
}
